[Desktop Entry]
Type=Application
Name=Kirie
GenericName=Screenshot Tool
Comment=Cut a piece out of your screen and mark it up
Exec=kirie edit %f
Icon=dev.samuelba.Kirie
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=screenshot;screen;capture;snip;annotate;markup;arrow;blur;
MimeType=image/png;image/jpeg;image/webp;application/x-kirie;
StartupNotify=true
StartupWMClass=dev.samuelba.Kirie
SingleMainWindow=true
Actions=capture-region;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action capture-region]
Name=Capture a Region
Exec=kirie capture region
