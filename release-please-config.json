{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-commit-authors": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "kirie",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='kirie')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='kirie-capture')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='kirie-ui')].version" }
      ]
    }
  }
}
